# Шаблон .env — скопируйте в .env и заполните реальными значениями

# Погода
VISUAL_CROSSING_KEY=
WEATHER_PROVIDER=openmeteo

# Прокси для Telegram (socks5) — обязателен для РФ
PROXY_URL=

# JWT-аутентификация
JWT_SECRET=

# Логирование
LOG_LEVEL=INFO
LOG_FILE=server.log

# Окружение: development | production
APP_ENV=development

# Базовый URL приложения
APP_URL=http://localhost:8000

# Telegram бот
TG_BOT_TOKEN=
TG_ADMIN_ID=

# Включить Telegram-бота: true | false
ENABLE_BOT=true

# --- VK ID (отложено: требует профиль бизнеса VK и ИНН) ---
# VK_APP_ID=
# VK_SECRET_KEY=
# VK_REDIRECT_URI=https://gripcheck.ru/auth/vk/callback

# --- Yandex OAuth (активно) ---
YA_CLIENT_ID=
YA_CLIENT_SECRET=
YA_REDIRECT_URI=https://gripcheck.ru/auth/yandex/callback